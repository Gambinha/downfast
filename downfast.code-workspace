{
  "folders": [
    {
      "name": "Root",
      "path": "."
    },
    {
      "name": "Frontend",
      "path": "downFast_frontend"
    },
    {
      "name": "Backend",
      "path": "server"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.exclude": {
      "**/node_modules": true,
      "**/build": true,
      "**/dist": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "ms-azuretools.vscode-docker",
      "cweijan.vscode-postgresql-client2",
      "eamodio.gitlens",
      "mikestead.dotenv",
      "humao.rest-client"
    ]
  }
}
